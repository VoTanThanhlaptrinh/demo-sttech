@using Demo.Web.Models.Faqs
@using Demo.Web.Startup
@model FaqListViewModel
@{
    ViewBag.Title = "Quản lý câu hỏi thường gặp";
    ViewBag.CurrentPageName = PageNames.Faq;
}
@section styles
{
    <link rel="stylesheet" href="~/view-resources/Views/Faq/Index.css" asp-append-version="true" />
}
@section scripts
{
    <script src="~/view-resources/Views/Faq/ErrorHandler.js" asp-append-version="true"></script>
    <script src="~/view-resources/Views/Faq/Table.js" asp-append-version="true"></script>
    <script src="~/view-resources/Views/Faq/Create.js" asp-append-version="true"></script>
    <script src="~/view-resources/Views/Faq/Edit.js" asp-append-version="true"></script>
    <script src="~/view-resources/Views/Faq/Index.js" asp-append-version="true"></script>
}

<section class="content-header">
    <div class="container-fluid">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center">
            <div class="mb-2 mb-sm-0">
                <h1 class="mb-1">Quản lý câu hỏi thường gặp</h1>
                <p class="text-muted mb-0">Quản lý nội dung và trạng thái hiển thị của FAQ</p>
            </div>
            <div class="w-100 w-sm-auto text-sm-end">
                <button type="button" class="btn btn-primary text-nowrap" id="CreateFaqBtn">
                    <i class="fa fa-plus me-1"></i>
                    Thêm FAQ
                </button>
            </div>
        </div>
    </div>
</section>

<section class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-outline card-primary shadow-sm mb-4">
                    <div class="card-body">
                        <!-- Filter section: 2-row responsive layout -->
                        <form id="FaqFilterForm" onsubmit="return false;">
                            <div class="row g-2">
                                <!-- Dòng 1: Ô tìm kiếm từ khóa trải rộng -->
                                <div class="col-12 mb-1">
                                    <div class="input-group">
                                        <span class="input-group-text bg-light text-muted">
                                            <i class="fas fa-search"></i>
                                        </span>
                                        <input type="text" 
                                               id="FaqSearchKeyword" 
                                               class="form-control" 
                                               placeholder="Nhập câu hỏi hoặc nội dung câu trả lời..." 
                                               autocomplete="off" />
                                    </div>
                                </div>
                                <!-- Dòng 2: Bộ lọc trạng thái, số dòng và các nút bấm -->
                                <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                                    <select id="FaqStatusFilter" class="form-select form-control">
                                        <option value="">Tất cả trạng thái</option>
                                        @if (Model?.Statuses != null)
                                        {
                                            @foreach (var status in Model.Statuses)
                                            {
                                                <option value="@status.Value">@status.Text</option>
                                            }
                                        }
                                        else
                                        {
                                            <option value="1">Công khai</option>
                                            <option value="2">Đang ẩn</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-12 col-sm-6 col-md-3 col-lg-2">
                                    <select id="FaqPageLength" class="form-select form-control" title="Số dòng hiển thị">
                                        <option value="5">5 dòng</option>
                                        <option value="10" selected>10 dòng</option>
                                        <option value="20">20 dòng</option>
                                    </select>
                                </div>
                                <div class="col-12 col-md-5 col-lg-7 d-flex justify-content-start justify-content-md-end gap-2">
                                    <button type="button" class="btn btn-outline-secondary text-nowrap px-3 flex-fill flex-md-grow-0" id="ResetFilterBtn" title="Đặt lại bộ lọc">
                                        <i class="fas fa-undo me-1"></i> Đặt lại
                                    </button>
                                    <button type="button" class="btn btn-primary text-nowrap px-4 flex-fill flex-md-grow-0" id="SearchBtn" title="Tìm kiếm">
                                        <i class="fas fa-search me-1"></i> Tìm kiếm
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table id="FaqTable" class="table table-striped table-bordered table-hover mb-0 w-100">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 60px;" class="text-center align-middle">STT</th>
                                        <th style="width: 32%;" class="align-middle">Câu hỏi</th>
                                        <th class="align-middle">Câu trả lời</th>
                                        <th style="width: 140px;" class="text-center align-middle">Trạng thái</th>
                                        <th style="width: 110px;" class="text-center align-middle">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <!-- Dynamic rows loaded via DataTables AJAX -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Modal Container for AJAX Partial Views -->
<div id="FaqModalContainer"></div>
